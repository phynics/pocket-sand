#!/usr/bin/env bash
#
# Photograph the app's screens, so that what it looks like can be reviewed — and, with
# baselines, diffed.
#
# Why this and not a UI test: there is no way to tap a simulator from the command line
# (no `idb` on this machine, and `simctl` has no touch command), and the Testing
# framework refuses to compile inside a UI-test bundle. So the app is not driven, it is
# *told* which screen to open — see `Apps/PocketSand/ScreenshotTour.swift` — and this
# script walks the matrix and waits for a readiness marker rather than guessing how
# long a screen takes to load.
#
#   ./scripts/screenshots                        # every screen, both appearances
#   ./scripts/screenshots newtask                # one screen, both appearances
#   ./scripts/screenshots newtask dark           # one screen, one appearance
#   SIZES="large accessibility-extra-extra-large" ./scripts/screenshots
#   SKIP_BUILD=1 ./scripts/screenshots list      # use whatever is built
#
# The server comes from the gitignored `local.mk`, like the live test suites, so a run
# against a real server needs no secrets on the command line. Without one, the screens
# that need data are photographed empty, which is a state worth having pictures of.
set -euo pipefail

cd "$(dirname "$0")/.."

BUNDLE_ID="dev.pocketsand.PocketSand"
DEVICE="${DEVICE:-booted}"
OUT="${OUT:-artifacts/screenshots}"
APP="${APP:-/tmp/ps-dd/Build/Products/Debug-iphonesimulator/PocketSand-iOS.app}"
SIZES="${SIZES:-large}"
APPEARANCES="${APPEARANCES:-light dark}"

# Screens that need a real server to be interesting. `connect` needs none: the tour
# clears the saved bookmarks so the connect screen is what gets photographed.
ALL_SCREENS=(list newtask chat setup detail connect)

# `local.mk` is Make syntax, not shell, so its values are read rather than sourced.
# Every value is optional: without one, the screens that need data are photographed
# empty, which is a state worth having pictures of.
value_from_local_mk() {
    [ -f local.mk ] || return 0
    # `sed -n` rather than `grep | sed`: a variable that is not in the file is the
    # ordinary case here, and under `set -o pipefail` a grep that matches nothing fails
    # the whole assignment — which `set -e` turns into a silent exit.
    sed -nE "s/^$1[[:space:]]*\??=[[:space:]]*//p" local.mk | tail -1
}

KANDEV="${KANDEV:-$(value_from_local_mk KANDEV)}"
KANDEV_TOKEN="${KANDEV_TOKEN:-$(value_from_local_mk KANDEV_TOKEN)}"
KANDEV_TASK="${KANDEV_TASK:-$(value_from_local_mk KANDEV_TASK)}"

# Plain strings rather than arrays: nothing here needs an array, and "no screens named"
# is an ordinary case rather than an exceptional one.
screens=""
for argument in "$@"; do
    case "$argument" in
        light|dark) APPEARANCES="$argument" ;;
        *) screens="$screens $argument" ;;
    esac
done
screens="${screens# }"
[ -n "$screens" ] || screens="${ALL_SCREENS[*]}"

# `detail` needs a task to open, and a run that asks for one without naming it would
# sit waiting for a screen that can never settle. Say so rather than fail.
case " $screens " in
    *" detail "*)
        if [ -z "${KANDEV_TASK:-}" ]; then
            screens="$(printf '%s\n' $screens | grep -v '^detail$' | tr '\n' ' ')"
            screens="${screens% }"
            printf 'Skipping detail: set KANDEV_TASK=<task-id> to photograph a transcript.\n'
        fi
        ;;
esac

step() { printf '\033[1m%s\033[0m\n' "$1"; }

if [ "${SKIP_BUILD:-0}" != "1" ]; then
    step "Building for the simulator"
    xcodebuild -project PocketSand.xcodeproj -scheme PocketSand-iOS \
        -destination 'platform=iOS Simulator,name=iPhone 17 Pro' \
        -derivedDataPath /tmp/ps-dd build >/dev/null
fi

if ! xcrun simctl list devices booted | grep -q "Booted"; then
    step "Booting a simulator"
    xcrun simctl boot "iPhone 17 Pro" || true
    sleep 20
fi

xcrun simctl install "$DEVICE" "$APP"

# A frozen status bar, because a clock that says 20:47 in one shot and 20:49 in the next
# turns every diff into a difference in the time.
xcrun simctl status_bar "$DEVICE" override \
    --time "9:41" \
    --batteryState charged --batteryLevel 100 \
    --cellularMode active --cellularBars 4 \
    --wifiMode active --wifiBars 3 >/dev/null

mkdir -p "$OUT"
# A full run replaces the set. A filtered run is usually adding to it — an appearance,
# a text size, one screen — so it leaves what is already there alone rather than
# throwing away the pictures it is not replacing.
if [ "$#" -eq 0 ]; then
    rm -f "$OUT"/*.png
fi

# Where the app says it has settled. Read from the host, so nothing has to be parsed
# out of a log or waited out with a sleep.
container="$(xcrun simctl get_app_container "$DEVICE" "$BUNDLE_ID" data)"
ready_file="$container/Documents/screenshot-ready"

captured=0
failed=

for appearance in $APPEARANCES; do
    xcrun simctl ui "$DEVICE" appearance "$appearance" >/dev/null
    for size in $SIZES; do
        xcrun simctl ui "$DEVICE" content_size "$size" >/dev/null
        for screen in $screens; do
            environment=("SIMCTL_CHILD_KANDEV_SCREEN=$screen")
            if [ -n "${KANDEV:-}" ] && [ "$screen" != "connect" ]; then
                environment+=("SIMCTL_CHILD_KANDEV_DEV_SERVER=$KANDEV")
                [ -n "${KANDEV_TOKEN:-}" ] && environment+=("SIMCTL_CHILD_KANDEV_DEV_TOKEN=$KANDEV_TOKEN")
            fi
            [ -n "${KANDEV_TASK:-}" ] && environment+=("SIMCTL_CHILD_KANDEV_TASK=$KANDEV_TASK")
            # SCROLL names a place on the screen to be shown, for what is below the fold.
            [ -n "${SCROLL:-}" ] && environment+=("SIMCTL_CHILD_KANDEV_SCROLL=$SCROLL")

            xcrun simctl terminate "$DEVICE" "$BUNDLE_ID" >/dev/null 2>&1 || true
            rm -f "$ready_file"
            env "${environment[@]}" xcrun simctl launch \
                --terminate-running-process \
                "$DEVICE" "$BUNDLE_ID" >/dev/null

            # Wait for the screen to say it has settled, rather than for a duration that
            # is right on this machine and wrong on a slower one. The marker is a file
            # in the app's container, and it names the screen so a run cannot pass by
            # photographing the wrong one.
            state=""
            for _ in $(seq 1 120); do
                if [ -f "$ready_file" ]; then
                    # "<screen> <state>". The screen has to match, or a run that asked for
                    # one screen quietly files another screen's picture under its name.
                    read -r settled as < "$ready_file" || true
                    if [ "$settled" = "$screen" ]; then
                        state="$as"
                        break
                    fi
                fi
                sleep 0.25
            done

            suffix=""
            [ -n "${SCROLL:-}" ] && suffix="-$SCROLL"
            file="$OUT/$screen-$appearance-$size$suffix.png"
            xcrun simctl io "$DEVICE" screenshot "$file" >/dev/null 2>&1
            captured=$((captured + 1))

            case "$state" in
                loaded) printf '  %-44s ok\n' "$(basename "$file")" ;;
                ready) printf '  %-44s ok\n' "$(basename "$file")" ;;
                failed)
                    # Photographed anyway: an empty state is a state, and a picture of one
                    # is worth having. But it is not evidence about how a loaded screen
                    # looks, so the run says so and exits non-zero.
                    printf '  %-44s settled empty or failed\n' "$(basename "$file")"
                    failed="$failed $screen/$appearance/$size"
                    ;;
                *) printf '  %-44s never settled\n' "$(basename "$file")"
                   failed="$failed $screen/$appearance/$size" ;;
            esac
        done
    done
done

# A contact sheet, because a directory of fifty PNGs is a directory nobody opens.
{
    echo "# Screenshots"
    echo
    echo "Captured by \`scripts/screenshots\`. Not reviewed by a test — this is the thing to"
    echo "look at when appearance changes, and the thing to diff when comparing runs."
    echo
    for file in "$OUT"/*.png; do
        [ -e "$file" ] || continue
        name="$(basename "$file" .png)"
        echo "## $name"
        echo
        echo "![${name}]($(basename "$file"))"
        echo
    done
} > "$OUT/index.md"

step "$captured screenshots in $OUT (index.md is the contact sheet)"
if [ -n "$failed" ]; then
    printf 'Not photographed as loaded:%s\n' "$failed"
    printf 'A screen that settled empty or failed is usually a server that is not reachable.\n'
    exit 1
fi
